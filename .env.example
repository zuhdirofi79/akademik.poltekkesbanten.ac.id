APP_NAME="Layanan Akademik Poltekkes Kemenkes Banten"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akademik.poltekkesbanten.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akademik_poltekkesbanten
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Akun Admin Awal (dibaca oleh AdminUserSeeder, JANGAN commit .env asli) ---
SUPERADMIN_EMAIL=qowiyrofi@poltekkesbanten.ac.id
SUPERADMIN_PASSWORD=
SUPERADMIN_1_EMAIL=kuntum.ekawati@poltekkesbanten.ac.id
SUPERADMIN_1_PASSWORD=
SUPERADMIN_2_EMAIL=
SUPERADMIN_2_PASSWORD=
SUPERADMIN_3_EMAIL=
SUPERADMIN_3_PASSWORD=
DEFAULT_ADMIN_EMAIL=kuntum.ekawati@poltekkesbanten.ac.id
DEFAULT_ADMIN_PASSWORD=
FORCE_RESET_ADMIN_PASSWORD=false

# --- Akun Admin Jurusan (dibaca oleh AdminJurusanSeeder) ---
ADMIN_JURUSAN_DEFAULT_PASSWORD=rahasia
ADMIN_D3_KEBIDANAN_EMAIL=poltekkesadakpoltekkes@gmail.com
ADMIN_D3_KEBIDANAN_PASSWORD=Polkesten2026Akademik
ADMIN_D3_KEPERAWATAN_EMAIL=d3.keperawatan@poltekkesbanten.ac.id
ADMIN_D3_KEPERAWATAN_PASSWORD=Polkesten2026Akademik
ADMIN_D3_TLM_EMAIL=adak.tlm@poltekkesbanten.ac.id
ADMIN_D3_TLM_PASSWORD=Polkesten2026Akademik
ADMIN_STR_NERS_EMAIL=strners@poltekkesbanten.ac.id
ADMIN_STR_NERS_PASSWORD=Polkesten2026Akademik

# --- Email Development (tidak kirim ke inbox) ---
# MAIL_MAILER=log
# MAIL_FROM_ADDRESS="noreply@poltekkesbanten.ac.id"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Email Production SMTP (isi password hanya di .env server) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=ISI_HOST_SMTP_KAMPUS
MAIL_PORT=587
MAIL_USERNAME=email@poltekkesbanten.ac.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="email@poltekkesbanten.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# Path file upload privat (shared hosting Hostinger)
ACADEMIC_FILES_PATH=

# Kontak bantuan mahasiswa (opsional, ada default di config/akademik.php)
ADMIN_CONTACT_EMAIL=adak.direktorat@poltekesbanten.ac.id
ADMIN_CONTACT_WHATSAPP_URL=https://api.whatsapp.com/send/?phone=6282117170875&text&type=phone_number&app_absent=0

# URL CSS eksternal (opsional)
CSS_URL=

VITE_APP_NAME="${APP_NAME}"
